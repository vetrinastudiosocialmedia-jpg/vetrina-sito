# Copia questo file come ".env.local" e inserisci i valori.
# Su GitHub gli stessi valori vanno in Settings → Secrets and variables → Actions → Secrets
# (stesso nome, senza "NEXT_PUBLIC_").

# Link di pagamento Stripe (hanno la precedenza su PayPal)
NEXT_PUBLIC_STRIPE_LINK_ESSENZIALE=
NEXT_PUBLIC_STRIPE_LINK_CRESCITA=
NEXT_PUBLIC_STRIPE_LINK_PRO=

# Piani PayPal (usati solo se manca il link Stripe)
NEXT_PUBLIC_PAYPAL_PLAN_ESSENZIALE=
NEXT_PUBLIC_PAYPAL_PLAN_CRESCITA=
NEXT_PUBLIC_PAYPAL_PLAN_PRO=
